# backend/.env.example — schema only. Copy to backend/.env locally,
# fill values, and NEVER commit the copy (backend/.env is .gitignored).
# All keys below must exist at runtime; empty placeholders are intentional
# so config.py fail-safe defaults (PROD_MODE=False, CI_TEST_ISSUER_ENABLED=False)
# apply on the safe path.

# --- Core datastore ---
MONGO_URL=
DB_NAME=

# --- Auth / sessions ---
JWT_SECRET=
JWT_ALGORITHM=
JWT_EXPIRES_HOURS=
POLICY_TEXT_VERSION=
SESSION_COOKIE_SECURE=

# --- Storage ---
STORAGE_ROOT=

# --- LLM (Emergent-managed universal key) ---
EMERGENT_LLM_KEY=

# --- Internal service token (X-Service-Token on /api/internal/*) ---
INTERNAL_SERVICE_TOKEN=

# --- Runtime flags ---
CI_TEST_ISSUER_ENABLED=
PROD_MODE=
CORS_ALLOW_ORIGINS=

# --- Payments (test key ships in pod env; leave empty locally) ---
STRIPE_API_KEY=

# --- Web push (VAPID; regenerating invalidates every subscription) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Feature flags ---
APPLY_AT_BIRTH_ENABLED=
