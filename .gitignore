# Environment files
# NOTE: backend/.env and frontend/.env are intentionally NOT ignored.
# The Emergent deploy pipeline requires them present in the repo and
# auto-overwrites them with production values on deploy. See PRD /
# CHANGELOG deployment-readiness sections.
# .venv-local ignores below cover ad-hoc local `.env.local`-style files.
.env.local
.env.*.local

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/

# Node
node_modules/
.next/
build/
dist/

# IDE
.vscode/
.idea/
*.swp
.DS_Store

# Logs
*.log
