# Environment files
# Public-repo architecture (2026-02-21): backend/.env + frontend/.env are
# intentionally UNTRACKED. Emergent's publish pipeline reads them from the
# workspace filesystem (support_agent confirmed), NOT from git — so they
# never need to be in the tracked repo. Historical values that were
# tracked before 2026-02-21 are world-readable via git history but are
# fossils; no current live deploy value ever matches them.
# config.py defaults are fail-safe (PROD_MODE=False, CI_TEST_ISSUER_ENABLED=False
# when unset), so a missing workspace .env would boot in safe not-prod mode.
backend/.env
frontend/.env
mobile/.env
.env.local
.env.*.local
# Universal catch-all for any nested .env; .env.example is preserved because
# example files carry only key NAMES with empty placeholders (config schema
# preserved for founder + fork agents).
**/*.env
!**/*.env.example
# Candidate prod secrets are handed to the founder out-of-band and MUST
# never enter git history.
memory/.prod_secrets_DO_NOT_COMMIT
memory/.*.secret
# Test credentials are read by the local testing agent and MUST NOT be
# tracked in the shared repo. Kept on disk, ignored from git.
memory/test_credentials.md
# Transient debug/curl artifacts — never merge to main.
tmp_*.json
tmp_cookies.txt
tmp_*.txt
oa.json

# Local runtime storage for uploaded artifacts (documents, resumes, etc.).
# Keep the directory itself via .gitkeep so app boot doesn't fail on
# missing STORAGE_ROOT; ignore every real payload.
backend/storage/*
!backend/storage/.gitkeep

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/

# Node
node_modules/
.next/
build/
dist/

# IDE
.vscode/
.idea/
*.swp
.DS_Store

# Logs
*.log
.env
.env.*
*.env
credentials.json
*.pem
*.key
.credentials
