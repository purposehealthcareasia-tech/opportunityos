# frontend/.env.example — schema only. Copy to frontend/.env locally,
# fill values, and NEVER commit the copy (frontend/.env is .gitignored).

# --- Backend endpoint (production external URL for the API) ---
REACT_APP_BACKEND_URL=

# --- CRA dev-server ergonomics (leave blank on prod builds) ---
WDS_SOCKET_PORT=
WATCHPACK_POLLING=
CHOKIDAR_USEPOLLING=
BROWSER=
DANGEROUSLY_DISABLE_HOST_CHECK=
GENERATE_SOURCEMAP=
ESLINT_NO_DEV_ERRORS=
TSC_COMPILE_ON_ERROR=
